# ============ TRADING BOT CONFIGURATION ============
# Copy to .env and fill in. NEVER commit .env.

# --- Exchange credentials (only needed for LIVE mode; paper mode uses public data) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Targeted configuration ---
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,BNB/USDT
TIMEFRAME=15m
CAPITAL=1000.0

# --- Strategy ---
STRATEGY=momentum           # momentum | mean-reversion
MODE=paper                  # paper (default) | live

# --- Order execution ---
ORDER_TYPE=limit            # limit (60s timeout -> market fallback) | market
LIMIT_TIMEOUT_SECONDS=60
TAKER_FEE=0.001             # 0.1% taker fee (Binance spot standard)
MAKER_FEE=0.001             # 0.1% maker fee
MAX_SLIPPAGE=0.0005         # 0.05% max simulated slippage in paper mode

# --- Risk limits ---
RISK_PER_TRADE=0.01         # 1% of equity risked per trade
MAX_DRAWDOWN=0.10           # 10% total account kill-switch
MAX_DAILY_RISK=0.05         # 5% daily risk cap
MAX_LEVERAGE=3              # hard cap (spot => effective 1x)

# --- Risk parameters per trade (momentum) ---
ATR_PERIOD=14
ATR_SL_MULT=1.5             # stop-loss = ATR * mult
ATR_TP_MULT=3.0             # take-profit = ATR * mult (3:1 reward:risk)

# --- Paper-mode signal tuning ---
EMA_FAST=8                  # faster EMA for paper testing
EMA_SLOW=21
TREND_EMA=50                # faster trend filter (50 instead of 200)
USE_TREND_FILTER=false      # disabled for paper to increase signal frequency
RSI_PERIOD=14
RSI_FILTER_HIGH=70          # skip longs when RSI > 70
RSI_FILTER_LOW=30           # skip shorts when RSI < 30

# --- Self-improvement ---
MIN_TRADES_REVIEW=100
MIN_RUNTIME_REVIEW_DAYS=7

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
